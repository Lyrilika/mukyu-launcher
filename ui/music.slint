import { Theme, Ease, Icons } from "theme.slint";
import { Ico, Marquee, Dropdown, MenuItem, ScrollBox, WrapText } from "widgets.slint";

export struct TrackRow {
    number: int,
    title: string,
    duration: string,
    favorite: bool,
    active: bool,
}

export global MusicApi {
    in-out property <int> mode: 0;
    in-out property <string> title: "Game BGM";
    in-out property <string> artist: "Choose a game and track";
    in-out property <string> album: "Your assigned game files stay on your device";
    in-out property <image> art;
    in-out property <bool> has-art: false;
    in-out property <int> art-gen: 0;
    in-out property <int> info-gen: 0;
    in-out property <bool> playing: false;
    in-out property <bool> connecting: false;
    in-out property <float> progress: 0;
    in-out property <bool> progress-enabled: false;
    in-out property <bool> progress-smooth: false;
    in-out property <string> time-now: "0:00";
    in-out property <string> time-total: "0:00";
    in-out property <float> duration: 0;
    in-out property <string> source-text: "Audio from your provided game files  ·  local playback";
    in-out property <bool> source-error: false;
    in-out property <bool> shuffle: false;
    in-out property <bool> repeat: false;
    in-out property <float> volume: 1.0;
    in-out property <bool> controls-enabled: false;
    in-out property <bool> play-enabled: false;
    in-out property <[MenuItem]> games: [{ text: "Only music of provided games will be available", enabled: false }];
    in-out property <int> game-index: 0;
    in-out property <int> language: 0;
    in-out property <bool> favorites-available: false;
    in-out property <bool> favorites-view: false;
    in-out property <[TrackRow]> tracks;
    in-out property <int> list-state: 2;
    in-out property <string> list-message: "Select a game to view its music";
    in-out property <int> list-gen: 0;
    in-out property <string> loader-path: "M 50 21 Z";
    in-out property <bool> intro: false;

    callback mode-changed(int);
    callback game-selected(int);
    callback language-changed(int);
    callback favorites-clicked();
    callback track-activated(int);
    callback favorite-toggled(int, bool);
    callback play-pause();
    callback previous();
    callback next();
    callback shuffle-clicked();
    callback repeat-clicked();
    callback seek(float);
    callback volume-changed(float);
    callback volume-committed(float);
}

component Replay {
    in property <int> gen;
    in property <duration> length: 460ms;
    in property <easing> curve: Ease.standard;
    out property <float> t: 1;
    property <bool> instant: false;
    animate t { duration: instant ? 0ms : length; easing: curve; }
    changed gen => {
        instant = true;
        t = 0;
        kick.running = true;
    }
    kick := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            instant = false;
            t = 1;
        }
    }
}

component Enter inherits Rectangle {
    in property <int> order;
    property <bool> on: MusicApi.intro;
    opacity: on ? 1 : 0;
    property <length> rise: on ? 0px : 16px;
    animate opacity { duration: 520ms; delay: 60ms + order * 65ms; easing: ease; }
    animate rise { duration: 640ms; delay: 60ms + order * 65ms; easing: Ease.standard; }
    Rectangle {
        y: root.rise;
        @children
    }
}

component ControlButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 22px;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <length> nudge-x: 0px;
    in property <angle> spin: 0deg;
    in property <length> size: 46px;
    callback clicked();
    property <bool> hot: ta.has-hover && enabled;
    property <int> pulses: 0;
    width: size;
    height: size;
    border-radius: size / 2;
    background: active ? (ta.pressed ? Theme.mix(Theme.mu-primary-container, Theme.mu-primary, 0.28) : hot ? Theme.mix(Theme.mu-primary-container, Theme.mu-primary, 0.14) : Theme.mu-primary-container)
              : ta.pressed && enabled ? Theme.alpha(Theme.mu-primary, 0.26) : hot ? Theme.alpha(Theme.mu-primary, 0.14) : transparent;
    opacity: enabled ? 1 : 0.30;
    animate background { duration: 180ms; }
    animate opacity { duration: 200ms; }
    transform-scale: ta.pressed && enabled ? 0.94 : 1;
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    animate transform-scale { duration: ta.pressed ? 100ms : 320ms; easing: ta.pressed ? ease-out : spring(0.4); }
    pulse := Replay { gen: root.pulses; length: 360ms; curve: ease-out; }
    Rectangle {
        property <length> spread: 10px * pulse.t;
        x: -spread;
        y: -spread;
        width: root.width + 2 * spread;
        height: root.height + 2 * spread;
        border-radius: root.border-radius + spread;
        background: Theme.alpha(Theme.mu-primary, 0.32 * (1 - pulse.t));
    }
    Ico {
        source: root.icon;
        size: root.icon-size;
        color: root.active ? Theme.mu-on-primary-container : root.hot ? Theme.mu-primary : Theme.mu-text-dim;
        x: (parent.width - self.width) / 2 + (root.hot ? root.nudge-x : 0px);
        transform-scale: ta.pressed && root.enabled ? 0.82 : root.hot ? 1.12 : 1;
        transform-rotation: root.hot ? root.spin : 0deg;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        animate transform-scale, transform-rotation, x { duration: 200ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1.3); }
        animate color { duration: 180ms; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.pulses += 1;
            root.clicked();
        }
    }
}

component PlayButton inherits Rectangle {
    width: 76px;
    height: 76px;
    property <bool> enabled: MusicApi.play-enabled;
    property <int> ripples: 0;
    glow := Rectangle {
        border-radius: 38px;
        drop-shadow-blur: ta.has-hover ? 34px : MusicApi.playing ? 28px : 26px;
        drop-shadow-color: Theme.alpha(Theme.mu-primary, ta.has-hover ? 0.52 : MusicApi.playing ? 0.40 : 0.34);
        background: Theme.alpha(Theme.mu-primary, 0.01);
        animate drop-shadow-blur, drop-shadow-color { duration: 220ms; }
    }
    face := Rectangle {
        border-radius: MusicApi.playing ? 26px : 38px;
        background: ta.pressed ? Theme.mu-primary-container : Theme.mu-primary;
        opacity: root.enabled ? 1 : 0.5;
        clip: true;
        animate border-radius { duration: 420ms; easing: Ease.soft-spring; }
        animate background { duration: 180ms; }
        icons := Rectangle {
            transform-scale: ta.pressed ? 0.84 : ta.has-hover ? 1.08 : 1;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            animate transform-scale { duration: 260ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1.3); }
            Ico {
                source: Icons.play;
                size: 34px;
                color: ta.pressed ? Theme.mu-on-primary-container : Theme.mu-on-primary;
                opacity: MusicApi.playing ? 0 : 1;
                transform-rotation: MusicApi.playing ? 90deg : 0deg;
                transform-scale: MusicApi.playing ? 0.3 : 1;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                animate opacity { duration: MusicApi.playing ? 110ms : 180ms; delay: MusicApi.playing ? 0ms : 70ms; }
                animate transform-rotation, transform-scale { duration: MusicApi.playing ? 300ms : 400ms; delay: MusicApi.playing ? 0ms : 40ms; easing: MusicApi.playing ? cubic-bezier(0.4, 0, 0.8, 0.4) : Ease.soft-spring; }
            }
            Ico {
                source: Icons.pause;
                size: 34px;
                color: ta.pressed ? Theme.mu-on-primary-container : Theme.mu-on-primary;
                opacity: MusicApi.playing ? 1 : 0;
                transform-rotation: MusicApi.playing ? 0deg : -90deg;
                transform-scale: MusicApi.playing ? 1 : 0.3;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                animate opacity { duration: MusicApi.playing ? 180ms : 110ms; delay: MusicApi.playing ? 70ms : 0ms; }
                animate transform-rotation, transform-scale { duration: MusicApi.playing ? 400ms : 300ms; delay: MusicApi.playing ? 40ms : 0ms; easing: MusicApi.playing ? Ease.soft-spring : cubic-bezier(0.4, 0, 0.8, 0.4); }
            }
        }
    }
    ripple := Replay { gen: root.ripples; length: 620ms; curve: cubic-bezier(0.2, 0.7, 0.2, 1); }
    Rectangle {
        border-radius: self.width / 2;
        border-width: 3px;
        border-color: Theme.alpha(Theme.mu-primary, 0.6);
        opacity: root.ripples > 0 ? 0.7 * (1 - ripple.t) : 0;
        transform-scale: 0.9 + 0.75 * ripple.t;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
    }
    ring := Rectangle {
        x: 7px;
        y: 7px;
        width: parent.width - 14px;
        height: parent.height - 14px;
        opacity: MusicApi.connecting ? 1 : 0;
        animate opacity { duration: 240ms; }
        if self.opacity > 0.01: Rectangle {
            border-radius: self.width / 2;
            border-width: 3px;
            border-color: Theme.alpha(Theme.mu-on-primary, 0.16);
        }
        if self.opacity > 0.01: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 100;
            viewbox-height: 100;
            stroke: Theme.mu-on-primary;
            stroke-width: 3px;
            stroke-line-cap: round;
            commands: "M 14.6 14.6 A 50 50 0 0 1 85.4 14.6";
            transform-rotation: mod(animation-tick() / 900ms, 1.0) * 360deg;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.ripples += 1;
            MusicApi.play-pause();
        }
    }
}

component ProgressSlider inherits Rectangle {
    in property <float> value;
    in property <bool> enabled;
    in property <bool> smooth;
    in property <bool> compact: false;
    callback committed(float);
    callback preview(float);
    property <bool> dragging: false;
    property <float> drag-value: 0;
    property <float> shown: dragging ? drag-value : max(0, min(1, value));
    animate shown { duration: dragging ? 0ms : (smooth ? 650ms : 180ms); easing: smooth ? cubic-bezier(0.33, 1, 0.68, 1) : linear; }
    height: 30px;
    property <length> track-w: self.width - 12px;
    property <bool> hot: ta.has-hover && root.enabled;
    property <bool> down: ta.pressed && root.enabled;
    property <float> hover-frac: max(0, min(1, (ta.mouse-x - 6px) / root.track-w));
    property <length> bar-h: compact ? (down ? 5px : hot ? 6px : 4px) : (down ? 12px : hot ? 14px : 10px);
    animate bar-h { duration: 220ms; easing: Ease.soft-spring; }
    trough := Rectangle {
        x: 6px;
        y: (parent.height - self.height) / 2;
        width: root.track-w;
        height: root.bar-h;
        border-radius: self.height / 2;
        background: hot ? Theme.mix(Theme.mu-track, Theme.mu-primary, 0.18) : Theme.mu-track;
        animate background { duration: 240ms; }
    }
    ghost := Rectangle {
        x: 6px + root.track-w * root.shown;
        y: (parent.height - self.height) / 2;
        width: root.hot && root.hover-frac > root.shown ? root.track-w * (root.hover-frac - root.shown) : 0px;
        height: root.bar-h;
        border-radius: self.height / 2;
        background: Theme.alpha(Theme.mu-primary, 0.32);
        opacity: root.hot ? 1 : 0;
        animate width { duration: 140ms; easing: ease-out; }
        animate opacity { duration: 200ms; }
    }
    played := Rectangle {
        x: 6px;
        y: (parent.height - self.height) / 2;
        width: root.track-w * root.shown;
        visible: root.shown > 0.0005;
        height: root.bar-h;
        border-radius: self.height / 2;
        background: down ? Theme.mix(Theme.mu-primary, white, 0.25) : Theme.mu-primary;
        animate background { duration: 160ms; }
    }
    handle := Rectangle {
        width: compact ? (down ? 12px : hot ? 14px : 10px) : (down ? 10px : hot ? 8px : 6px);
        height: compact ? self.width : (down ? 24px : hot ? 34px : 30px);
        x: 6px + root.track-w * root.shown - self.width / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: Theme.mu-primary;
        animate width, height { duration: 260ms; easing: Ease.spring; }
        animate background { duration: 220ms; }
    }
    property <length> ripple-x;
    property <int> ripples: 0;
    ripple := Replay { gen: root.ripples; length: 520ms; curve: cubic-bezier(0.2, 0.7, 0.2, 1); }
    Rectangle {
        property <length> size: root.compact ? 10px + 22px * ripple.t : 14px + 34px * ripple.t;
        x: root.ripple-x - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: size;
        height: size;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: Theme.mu-primary;
        opacity: root.ripples > 0 ? 0.7 * (1 - ripple.t) : 0;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.ripple-x = max(6px, min(6px + root.track-w, self.mouse-x));
                root.ripples += 1;
                root.dragging = true;
                root.drag-value = max(0, min(1, (self.mouse-x - 6px) / root.track-w));
                root.preview(root.drag-value);
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) && root.dragging {
                root.dragging = false;
                root.committed(root.drag-value);
            }
        }
        moved => {
            if root.dragging {
                root.drag-value = max(0, min(1, (self.mouse-x - 6px) / root.track-w));
                root.preview(root.drag-value);
            }
        }
    }
}

component TrackRowItem inherits Rectangle {
    in property <TrackRow> item;
    in property <int> index;
    callback activate();
    callback fav(bool);
    property <int> pops: 0;
    height: 48px;
    border-radius: 18px;
    background: item.active ? Theme.alpha(Theme.mu-primary, 0.16) : ta.pressed ? Theme.alpha(Theme.mu-primary, 0.17) : ta.has-hover ? Theme.alpha(Theme.mu-primary, 0.10) : transparent;
    animate background { duration: 180ms; }
    transform-scale: ta.pressed ? 0.975 : 1;
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    animate transform-scale { duration: ta.pressed ? 120ms : 460ms; easing: ta.pressed ? ease-out : spring(0.4); }
    property <length> tap-x;
    property <length> tap-y;
    property <int> taps: 0;
    tap := Replay { gen: root.taps; length: 680ms; curve: cubic-bezier(0.23, 1, 0.32, 1); }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.tap-x = self.mouse-x;
                root.tap-y = self.mouse-y;
                root.taps += 1;
            }
        }
        clicked => { root.activate(); }
    }
    Rectangle {
        border-radius: root.border-radius;
        clip: true;
        Rectangle {
            property <length> size: 2.2 * root.width * tap.t;
            x: root.tap-x - self.width / 2;
            y: root.tap-y - self.height / 2;
            width: size;
            height: size;
            border-radius: self.width / 2;
            background: Theme.mu-primary;
            opacity: root.taps > 0 ? 0.22 * (1 - tap.t) : 0;
        }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 12px;
        Rectangle {
            width: 26px;
            Text {
                width: parent.width;
                height: parent.height;
                text: item.number;
                horizontal-alignment: right;
                vertical-alignment: center;
                color: Theme.mu-text-dim;
                font-size: Theme.px(12px);
                opacity: item.active ? 0 : 1;
                transform-scale: item.active ? 0.6 : 1;
                transform-origin: { x: self.width - 8px, y: self.height / 2 };
                animate opacity { duration: item.active ? 100ms : 180ms; delay: item.active ? 0ms : 80ms; }
                animate transform-scale { duration: item.active ? 140ms : 380ms; delay: item.active ? 0ms : 80ms; easing: item.active ? ease-in : spring(0.3); }
            }
            eq := Rectangle {
                property <float> level: MusicApi.playing ? 1 : 0;
                animate level { duration: MusicApi.playing ? 420ms : 320ms; easing: MusicApi.playing ? spring(0.35) : cubic-bezier(0.3, 0, 0.8, 0.15); }
                property <float> beat: item.active && MusicApi.playing ? animation-tick() / 1ms : 0;
                x: parent.width - 18px;
                width: 18px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                opacity: item.active ? 1 : 0;
                transform-scale: item.active ? 1 : 0.3;
                transform-origin: { x: self.width / 2, y: self.height };
                animate opacity { duration: item.active ? 160ms : 100ms; delay: item.active ? 60ms : 0ms; }
                animate transform-scale { duration: item.active ? 520ms : 140ms; delay: item.active ? 60ms : 0ms; easing: item.active ? spring(0.45) : cubic-bezier(0.3, 0, 0.8, 0.15); }
                for b[k] in [{ f: 1.7, g: 2.9, p: 0deg }, { f: 2.3, g: 1.3, p: 120deg }, { f: 1.4, g: 3.4, p: 240deg }]: Rectangle {
                    property <float> wave: 0.5 + 0.3 * Math.sin(eq.beat * 0.36deg * b.f + b.p) + 0.2 * Math.sin(eq.beat * 0.36deg * b.g + b.p * 2);
                    x: k * 6px + 1px;
                    width: 4px;
                    height: 4px + 14px * eq.level * wave;
                    y: parent.height - self.height;
                    border-radius: 2px;
                    background: Theme.mu-primary;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Marquee {
                text: item.title;
                fg: item.active ? Theme.mu-primary : Theme.mu-text;
                weight: 700;
                font-size: Theme.base;
                active: ta.has-hover || item.active;
            }
            Text {
                text: item.duration;
                color: Theme.mu-text-dim;
                font-size: Theme.px(11px);
            }
        }
        star := Rectangle {
            width: 36px;
            height: 36px;
            y: (parent.height - self.height) / 2;
            border-radius: 18px;
            background: sta.has-hover ? Theme.alpha(Theme.mu-primary, 0.12) : transparent;
            animate background { duration: 150ms; }
            burst := Replay { gen: root.pops; length: 620ms; curve: cubic-bezier(0.23, 1, 0.32, 1); }
            Rectangle {
                property <length> size: 12px + 24px * burst.t;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: size;
                height: size;
                border-radius: self.width / 2;
                border-width: 1px + 3px * (1 - burst.t);
                border-color: Theme.mu-primary;
                opacity: root.pops > 0 ? 0.8 * (1 - burst.t) : 0;
            }
            for k in 8: Rectangle {
                property <angle> a: k * 45deg + 22.5deg;
                property <length> reach: (Math.mod(k, 2) == 0 ? 17px : 13px) * burst.t + 5px;
                property <length> dot: (Math.mod(k, 2) == 0 ? 4px : 3px) * (1 - 0.7 * burst.t);
                x: parent.width / 2 + reach * Math.cos(a) - self.width / 2;
                y: parent.height / 2 + reach * Math.sin(a) - self.height / 2;
                width: dot;
                height: dot;
                border-radius: self.width / 2;
                background: Math.mod(k, 2) == 0 ? Theme.mu-primary : Theme.mix(Theme.mu-primary, white, 0.35);
                opacity: root.pops > 0 && burst.t < 0.999 ? 1 - burst.t * burst.t : 0;
            }
            icon := Rectangle {
                width: 18px;
                height: 18px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                transform-scale: sta.pressed ? 0.78 : sta.has-hover ? 1.12 : 1;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                animate transform-scale { duration: sta.pressed ? 110ms : 420ms; easing: sta.pressed ? ease-out : spring(0.45); }
                Ico {
                    source: Icons.star-outline;
                    size: 18px;
                    color: sta.has-hover ? Theme.mu-primary : Theme.mu-text-dim;
                    opacity: item.favorite ? 0 : 1;
                    transform-scale: item.favorite ? 0.5 : 1;
                    transform-origin: { x: self.width / 2, y: self.height / 2 };
                    animate opacity { duration: item.favorite ? 90ms : 160ms; delay: item.favorite ? 0ms : 60ms; }
                    animate transform-scale { duration: item.favorite ? 120ms : 360ms; delay: item.favorite ? 0ms : 60ms; easing: item.favorite ? ease-in : spring(0.3); }
                    animate color { duration: 150ms; }
                }
                Ico {
                    source: Icons.star;
                    size: 18px;
                    color: Theme.mu-primary;
                    opacity: item.favorite ? 1 : 0;
                    transform-scale: item.favorite ? 1 : 0.4;
                    transform-rotation: item.favorite ? 0deg : -72deg;
                    transform-origin: { x: self.width / 2, y: self.height / 2 };
                    animate opacity { duration: item.favorite ? 120ms : 140ms; }
                    animate transform-scale { duration: item.favorite ? 560ms : 160ms; easing: item.favorite ? spring(0.55) : cubic-bezier(0.3, 0, 0.8, 0.15); }
                    animate transform-rotation { duration: item.favorite ? 620ms : 160ms; easing: item.favorite ? spring(0.35) : cubic-bezier(0.3, 0, 0.8, 0.15); }
                }
            }
            sta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if !item.favorite { root.pops += 1; }
                    root.fav(!item.favorite);
                }
            }
        }
    }
}

component LoadingBlob inherits Rectangle {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    background: Theme.mu-primary-container;
    property <bool> on: true;
    opacity: 1;
    Path {
        width: 64px;
        height: 64px;
        viewbox-width: 100;
        viewbox-height: 100;
        fill: Theme.mu-on-primary-container;
        commands: MusicApi.loader-path;
    }
}

component TrackPanel inherits Rectangle {
    in property <{width: length, height: length}> window-size;
    border-radius: 28px;
    background: Theme.alpha(Theme.mu-surface-container, 0.92);
    animate background { duration: 500ms; }
    swap := Replay { gen: MusicApi.list-gen; length: 460ms; }
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        Dropdown {
            h: 44px;
            centered: false;
            max-popup-height: min(420px, root.height - self.y - self.height - 6px);
            window-size: root.window-size;
            items: MusicApi.games;
            current: MusicApi.game-index;
            selected(i) => { MusicApi.game-index = i; MusicApi.game-selected(i); }
        }
        HorizontalLayout {
            alignment: end;
            lang := Rectangle {
                width: 2 * 44px;
                height: 28px;
                border-radius: 14px;
                background: Theme.mu-surface-high;
                border-width: 1px;
                border-color: Theme.alpha(Theme.mu-text-dim, 0.2);
                clip: true;
                Rectangle {
                    x: MusicApi.language * 44px + 2px;
                    y: 2px;
                    width: 40px;
                    height: 24px;
                    border-radius: 12px;
                    background: Theme.mu-primary;
                    animate x { duration: 220ms; easing: Ease.soft-spring; }
                    animate background { duration: 500ms; }
                }
                for label[i] in ["EN", "JP"]: Rectangle {
                    x: i * 44px;
                    width: 44px;
                    Text {
                        text: label;
                        font-weight: 700;
                        font-size: Theme.base;
                        color: MusicApi.language == i ? Theme.mu-on-primary : lta.has-hover ? Theme.mu-text : Theme.mu-text-dim;
                        animate color { duration: 180ms; }
                    }
                    lta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if MusicApi.language != i {
                                MusicApi.language = i;
                                MusicApi.language-changed(i);
                            }
                        }
                    }
                }
            }
        }
        fav-wrap := Rectangle {
            height: MusicApi.favorites-available ? 40px : 0px;
            opacity: MusicApi.favorites-available ? 1 : 0;
            animate height { duration: 380ms; easing: Ease.emphasized; }
            animate opacity { duration: 320ms; }
            clip: true;
            Rectangle {
                y: MusicApi.favorites-available ? 0px : -10px;
                animate y { duration: 380ms; easing: Ease.emphasized; }
                height: 40px;
                border-radius: 18px;
                background: MusicApi.favorites-view ? Theme.alpha(Theme.mu-primary, 0.16) : fta.has-hover ? Theme.alpha(Theme.mu-primary, 0.13) : transparent;
                animate background { duration: 160ms; }
                HorizontalLayout {
                    padding-left: 10px;
                    spacing: 10px;
                    Ico {
                        y: (parent.height - self.height) / 2;
                        source: Icons.star;
                        size: 18px;
                        color: fta.has-hover || MusicApi.favorites-view ? Theme.mu-primary : Theme.mu-text-dim;
                    }
                    Text {
                        text: "Favorites";
                        font-weight: 700;
                        font-size: Theme.base;
                        vertical-alignment: center;
                        color: fta.has-hover || MusicApi.favorites-view ? Theme.mu-primary : Theme.mu-text-dim;
                    }
                }
                fta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { MusicApi.favorites-clicked(); }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.alpha(Theme.mu-text-dim, 0.35);
        }
        list := Rectangle {
            vertical-stretch: 1;
            opacity: swap.t;
            property <length> rise: 12px * (1 - swap.t);
            if MusicApi.list-state == 0: ScrollBox {
                y: list.rise;
                height: list.height;
                content-height: MusicApi.tracks.length * 52px;
                for row[i] in MusicApi.tracks: TrackRowItem {
                    y: i * 52px + 2px;
                    width: parent.width - 4px;
                    item: row;
                    index: i;
                    activate => { MusicApi.track-activated(i); }
                    fav(on) => { MusicApi.favorite-toggled(i, on); }
                }
            }
            if MusicApi.list-state == 1: VerticalLayout {
                y: list.rise;
                alignment: center;
                spacing: 14px;
                HorizontalLayout {
                    alignment: center;
                    LoadingBlob { }
                }
                Text {
                    text: "Loading songs…";
                    horizontal-alignment: center;
                    color: Theme.mu-text-dim;
                    font-size: Theme.px(12px);
                }
            }
            if MusicApi.list-state == 2: VerticalLayout {
                y: list.rise;
                alignment: center;
                spacing: 8px;
                padding: 20px;
                HorizontalLayout {
                    alignment: center;
                    Ico {
                        source: Icons.music;
                        size: 34px;
                        color: Theme.mu-text-dim;
                        opacity: 0.5;
                    }
                }
                WrapText {
                    text: MusicApi.list-message;
                    align: center;
                    ink: Theme.mu-text-dim;
                    font-size: Theme.px(12px);
                }
            }
        }
    }
}

export component MusicPage inherits Rectangle {
    property <bool> game: MusicApi.mode == 0;
    background: @linear-gradient(165deg, Theme.mu-surface-high 0%, Theme.mu-surface 62%);
    clip: true;

    property <length> outer-pad: 24px;
    property <length> panel-w: 390px;
    property <length> panel-gap: 30px;
    property <float> game-progress: game ? 1 : 0;
    animate game-progress { duration: 420ms; easing: Ease.standard; }
    property <length> panel-space: (panel-gap + panel-w) * game-progress;
    property <length> player-w: max(340px, min(680px, root.width - 2 * outer-pad - panel-space));
    property <length> group-w: player-w + panel-space;
    property <length> body-y: 16px + 38px + 16px;
    property <length> body-h: root.height - body-y - 24px;

    Enter {
        order: 0;
        x: (root.width - 230px) / 2;
        y: 16px;
        width: 230px;
        height: 38px;
        Dropdown {
            width: 230px;
            window-size: { width: root.width, height: root.height };
            items: [{ text: "Game BGM", enabled: true }, { text: "Gensokyo Radio", enabled: true }];
            current: MusicApi.mode;
            selected(i) => { MusicApi.mode = i; MusicApi.mode-changed(i); }
        }
    }

    player := Rectangle {
        x: (root.width - root.group-w) / 2;
        y: root.body-y;
        width: root.player-w;
        height: root.body-h;
        property <length> fixed-h: info.height + 16px + 54px + 16px + 76px + 4px + 34px + 12px + 16px + 16px;
        property <length> art-area: max(220px, self.height - fixed-h);
        property <length> art-size: max(180px, min(self.width, art-area));

        Enter {
            order: 1;
            x: (parent.width - parent.art-size) / 2;
            y: (parent.art-area - parent.art-size) / 2;
            width: parent.art-size;
            height: parent.art-size;
            art-swap := Replay { gen: MusicApi.art-gen; length: 560ms; }
            wrap := Rectangle {
                transform-scale: (MusicApi.playing ? 1 : 0.92) * (0.93 + 0.07 * art-swap.t);
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                opacity: art-swap.t;
                animate transform-scale { duration: 560ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1.15); }
                Rectangle {
                    border-radius: 34px;
                    background: Theme.mu-primary-container;
                    drop-shadow-blur: MusicApi.playing ? 64px : 56px;
                    drop-shadow-color: Theme.alpha(Theme.mu-primary, MusicApi.playing ? 0.45 : 0.34);
                    animate drop-shadow-blur, drop-shadow-color, background { duration: 500ms; }
                }
                Rectangle {
                    border-radius: 34px;
                    clip: true;
                    if MusicApi.has-art: Image {
                        width: parent.width;
                        height: parent.height;
                        source: MusicApi.art;
                        image-fit: ImageFit.cover;
                    }
                    if !MusicApi.has-art: Ico {
                        source: Icons.music;
                        size: 96px;
                        color: Theme.mu-on-primary-container;
                        opacity: 0.65;
                    }
                }
            }
        }

        info := Enter {
            order: 2;
            y: parent.art-area + 16px;
            height: info-col.preferred-height;
            swap := Replay { gen: MusicApi.info-gen; length: 460ms; }
            info-col := VerticalLayout {
                opacity: swap.t;
                y: 12px * (1 - swap.t);
                spacing: 2px;
                Marquee {
                    text: MusicApi.title;
                    fg: Theme.mu-text;
                    font-size: Theme.px(26px);
                    weight: 800;
                    active: true;
                    align: center;
                }
                Text {
                    text: MusicApi.artist;
                    color: Theme.mu-text-dim;
                    font-size: Theme.base;
                    horizontal-alignment: center;
                    overflow: elide;
                    animate color { duration: 500ms; }
                }
                Text {
                    text: MusicApi.album;
                    color: Theme.mu-text-dim;
                    font-size: Theme.px(12px);
                    horizontal-alignment: center;
                    overflow: elide;
                    animate color { duration: 500ms; }
                }
            }
        }

        progress := Enter {
            order: 3;
            y: info.y + info.height + 16px;
            height: 54px;
            ProgressSlider {
                y: 0;
                value: MusicApi.progress;
                enabled: MusicApi.progress-enabled;
                smooth: MusicApi.progress-smooth;
                preview(v) => { MusicApi.time-now = Math.floor(v * MusicApi.duration / 60) + ":" + (Math.mod(Math.floor(v * MusicApi.duration), 60) < 10 ? "0" : "") + Math.mod(Math.floor(v * MusicApi.duration), 60); }
                committed(v) => { MusicApi.seek(v); }
            }
            Text {
                x: 0;
                y: 34px;
                text: MusicApi.time-now;
                font-weight: 700;
                font-size: Theme.base;
                color: Theme.mu-text-dim;
            }
            Text {
                y: 34px;
                x: parent.width - self.width;
                text: MusicApi.time-total;
                font-weight: 700;
                font-size: Theme.base;
                color: Theme.mu-text-dim;
            }
        }

        controls := Enter {
            order: 4;
            y: progress.y + progress.height + 16px;
            height: 76px;
            HorizontalLayout {
                alignment: center;
                spacing: 14px;
                ControlButton {
                    y: 15px;
                    icon: Icons.shuffle;
                    active: MusicApi.shuffle;
                    enabled: MusicApi.controls-enabled;
                    spin: -12deg;
                    clicked => { MusicApi.shuffle-clicked(); }
                }
                ControlButton {
                    y: 15px;
                    icon: Icons.skip-back;
                    icon-size: 28px;
                    enabled: MusicApi.controls-enabled;
                    nudge-x: -2px;
                    clicked => { MusicApi.previous(); }
                }
                PlayButton { }
                ControlButton {
                    y: 15px;
                    icon: Icons.skip-forward;
                    icon-size: 28px;
                    enabled: MusicApi.controls-enabled;
                    nudge-x: 2px;
                    clicked => { MusicApi.next(); }
                }
                ControlButton {
                    y: 15px;
                    icon: MusicApi.repeat ? Icons.repeat-one : Icons.repeat;
                    active: MusicApi.repeat;
                    enabled: MusicApi.controls-enabled;
                    spin: 24deg;
                    clicked => { MusicApi.repeat-clicked(); }
                }
            }
        }

        volume-row := Enter {
            order: 5;
            y: controls.y + controls.height + 4px;
            height: 34px;
            property <float> remembered: 1.0;
            property <length> slider-w: min(260px, self.width - 2 * (34px + 8px));
            mute := ControlButton {
                x: (parent.width - parent.slider-w) / 2 - 8px - self.width;
                y: (parent.height - self.height) / 2;
                size: 34px;
                icon: MusicApi.volume <= 0.001 ? Icons.volume-off : MusicApi.volume < 0.5 ? Icons.volume-low : Icons.volume-high;
                icon-size: 18px;
                clicked => {
                    if MusicApi.volume > 0.001 {
                        volume-row.remembered = MusicApi.volume;
                        MusicApi.volume-changed(0);
                        MusicApi.volume-committed(0);
                    } else {
                        MusicApi.volume-changed(max(0.05, volume-row.remembered));
                        MusicApi.volume-committed(max(0.05, volume-row.remembered));
                    }
                }
            }
            TouchArea {
                x: (parent.width - parent.slider-w) / 2;
                width: parent.slider-w;
                height: parent.height;
                scroll-event(e) => {
                    if e.delta-y == 0 { return reject; }
                    MusicApi.volume-changed(max(0, min(1, MusicApi.volume + (e.delta-y > 0 ? 0.05 : -0.05))));
                    MusicApi.volume-committed(MusicApi.volume);
                    accept
                }
                ProgressSlider {
                    x: 0;
                    width: parent.width;
                    y: (parent.height - self.height) / 2;
                    value: MusicApi.volume;
                    enabled: true;
                    smooth: true;
                    compact: true;
                    preview(v) => { MusicApi.volume-changed(v); }
                    committed(v) => { MusicApi.volume-committed(v); }
                }
            }
            Text {
                x: (parent.width + parent.slider-w) / 2 + 8px;
                width: 36px;
                height: parent.height;
                text: Math.round(MusicApi.volume * 100) + "%";
                font-weight: 700;
                font-size: Theme.px(11px);
                color: Theme.mu-text-dim;
                vertical-alignment: center;
            }
        }

        Enter {
            order: 6;
            y: volume-row.y + volume-row.height + 12px;
            height: 16px;
            Text {
                text: MusicApi.source-text;
                horizontal-alignment: center;
                font-size: Theme.px(11px);
                color: MusicApi.source-error ? Theme.mu-primary : Theme.mu-text-dim;
                opacity: 0.9;
                overflow: elide;
            }
        }
    }

    panel := TrackPanel {
        window-size: { width: root.width, height: root.height };
        x: player.x + player.width + root.panel-gap + (1 - root.game-progress) * 60px;
        y: root.body-y;
        width: root.panel-w;
        height: root.body-h;
        opacity: root.game ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 320ms; delay: root.game ? 90ms : 0ms; easing: cubic-bezier(0.2, 0, 0, 1); }
    }
}
