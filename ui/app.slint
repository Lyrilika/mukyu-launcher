import "fonts/Rubik.ttf";
import { Theme, Ease, Icons } from "theme.slint";
import { Ico, Scrim, MenuItem, WindowInfo } from "widgets.slint";
import { GamesPage, GamesApi, GameCardData, GameSettingsPopover, LibraryMode } from "games.slint";
import { MusicPage, MusicApi, TrackRow } from "music.slint";
import { PrintWorksPage, PrintApi, PrintWorkData } from "printworks.slint";
import { SettingsDialog, SettingsApi } from "settings.slint";
import { TitleBar } from "titlebar.slint";
import { MessageDialog, DownloadDialog, DialogApi, DownloadApi, DialogButton } from "dialogs.slint";
import { ReaderWindow } from "reader.slint";
import { UpdateDialog, UpdateApi, ChangelogDialog, ChangelogApi } from "update.slint";

export { Theme, GamesApi, GameCardData, LibraryMode, MusicApi, TrackRow, MenuItem, PrintApi, PrintWorkData, SettingsApi, DialogApi, DownloadApi, DialogButton, ReaderWindow, UpdateApi, ChangelogApi }

export global AppApi {
    in-out property <int> tab: 0;
    in-out property <bool> ready: false;
    in-out property <bool> window-expanded: false;
    callback minimize-window();
    callback toggle-window-maximized();
    callback close-window();
    callback tab-changed(int);
    callback escape();
    callback scrim-clicked();
}

component TabSwitcher inherits Rectangle {
    in property <bool> enabled: true;
    private property <[string]> labels: ["Games", "Music", "Print Works"];
    private property <length> tab-width: 122px;
    private property <length> selected-center: (AppApi.tab + 0.5) * tab-width;
    private property <length> leading-center: selected-center;
    private property <length> trailing-center: selected-center;
    private property <length> underline-width: AppApi.tab == 2 ? 88px : 56px;

    animate leading-center { duration: 250ms; easing: cubic-bezier(0.18, 0.78, 0.3, 1); }
    animate trailing-center { duration: 250ms; easing: cubic-bezier(0.32, 0.12, 0.28, 1); }
    animate underline-width { duration: 250ms; easing: Ease.standard; }

    width: labels.length * tab-width;
    height: 48px;
    forward-focus: keyboard;

    accessible-role: tab-list;
    accessible-enabled: enabled;
    accessible-orientation: Orientation.horizontal;
    accessible-item-count: labels.length;
    accessible-delegate-focus: AppApi.tab;

    function select-tab(index: int) {
        if root.enabled && index != AppApi.tab {
            AppApi.tab = index;
            AppApi.tab-changed(index);
        }
    }

    for label[i] in labels: Rectangle {
        property <bool> selected: AppApi.tab == i;
        property <bool> focused: selected && root.enabled && keyboard.has-focus;
        x: i * root.tab-width;
        width: root.tab-width;
        height: parent.height;

        accessible-role: tab;
        accessible-enabled: root.enabled;
        accessible-label: label;
        accessible-item-index: i;
        accessible-item-selectable: true;
        accessible-item-selected: self.selected;
        accessible-action-default => { root.select-tab(i); }

        Rectangle {
            x: 7px;
            y: 4px;
            width: parent.width - 2 * self.x;
            height: parent.height - 12px;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.alpha(Theme.accent, parent.focused ? 0.72 : 0);
            background: Theme.alpha(Theme.accent, touch.pressed ? 0.18 : touch.has-hover ? 0.10 : 0);
            animate background { duration: touch.pressed ? 85ms : 150ms; easing: Ease.standard; }
            animate border-color { duration: 150ms; easing: Ease.standard; }
        }

        Text {
            width: parent.width;
            height: parent.height - 4px;
            text: label;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: Theme.base + 2px;
            font-weight: 600;
            color: parent.selected || touch.has-hover ? Theme.fg : Theme.fg-dim;
            accessible-role: none;
            animate color { duration: 150ms; easing: Ease.standard; }
        }

        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { root.select-tab(i); }
        }
    }

    Rectangle {
        x: min(root.leading-center, root.trailing-center) - root.underline-width / 2;
        y: parent.height - self.height;
        width: root.underline-width + abs(root.leading-center - root.trailing-center);
        height: 3px;
        border-radius: self.height / 2;
        background: Theme.accent;
        animate background { duration: 180ms; easing: Ease.standard; }
    }

    keyboard := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.LeftArrow {
                root.select-tab(mod(AppApi.tab + root.labels.length - 1, root.labels.length));
                return accept;
            }
            if event.text == Key.RightArrow {
                root.select-tab(mod(AppApi.tab + 1, root.labels.length));
                return accept;
            }
            if event.text == Key.Home {
                root.select-tab(0);
                return accept;
            }
            if event.text == Key.End {
                root.select-tab(root.labels.length - 1);
                return accept;
            }
            reject
        }
    }
}

component GearButton inherits Rectangle {
    callback clicked();
    width: 40px;
    height: 40px;
    border-radius: ta.pressed ? 15px : 12px;
    background: ta.pressed ? Theme.alpha(Theme.accent, 0.24) : ta.has-hover ? Theme.alpha(Theme.accent, 0.14) : transparent;
    transform-scale: ta.pressed ? 0.92 : 1;
    animate background { duration: 180ms; }
    animate border-radius { duration: 220ms; easing: Ease.standard; }
    animate transform-scale { duration: 180ms; }
    Ico {
        source: Icons.gear;
        size: 21px;
        color: ta.has-hover || ta.pressed ? Theme.accent : Theme.fg-dim;
        transform-rotation: ta.pressed ? 70deg : ta.has-hover ? 35deg : 0deg;
        transform-scale: ta.pressed ? 0.9 : 1;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        animate transform-rotation, transform-scale { duration: 220ms; easing: Ease.standard; }
        animate color { duration: 180ms; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "Mukyu Launcher";
    icon: Icons.app-icon;
    preferred-width: 1280px;
    preferred-height: 720px + title-bar-height;
    min-width: 820px;
    min-height: 560px + title-bar-height;
    no-frame: !SettingsApi.system-title-bar;
    resize-border-width: self.no-frame ? 5px : 0px;
    background: Theme.bg;
    default-font-family: "Rubik";
    default-font-size: Theme.base;

    changed width => {
        Theme.scale = max(0.65, min(1.0, min(self.width / 1280px, content-height / 720px)));
        WindowInfo.width = self.width;
    }
    changed height => { WindowInfo.height = self.height; }
    changed content-height => {
        Theme.scale = max(0.65, min(1.0, min(self.width / 1280px, content-height / 720px)));
    }
    init => {
        Theme.scale = max(0.65, min(1.0, min(self.width / 1280px, content-height / 720px)));
        WindowInfo.width = self.width;
        WindowInfo.height = self.height;
        keys.focus();
    }

    property <length> title-bar-height: self.no-frame ? 36px : 0px;
    property <length> content-height: self.height - title-bar-height;
    property <bool> any-overlay: GamesApi.settings-open || SettingsApi.open || DialogApi.open || DownloadApi.open;
    property <float> page-pos: AppApi.tab;
    animate page-pos { duration: 260ms; easing: Ease.emphasized; }

    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape { AppApi.escape(); return accept; }
            reject
        }

        Rectangle {
            background: Theme.bg;
            animate background { duration: 300ms; }
        }

        header := Rectangle {
            y: root.title-bar-height;
            height: 58px;
            Rectangle {
                y: parent.height - self.height;
                height: 1px;
                background: Theme.alpha(Theme.fg, 0.08);
                animate background { duration: 180ms; easing: Ease.standard; }
            }
            TabSwitcher {
                x: round((parent.width - self.width) / 2px) * 1px;
                y: 10px;
                enabled: !root.any-overlay && !UpdateApi.open && !ChangelogApi.open;
            }
            GearButton {
                x: parent.width - self.width - 12px;
                y: (parent.height - self.height) / 2 + 2px;
                clicked => { SettingsApi.open = true; SettingsApi.page = 2; }
            }
        }

        pages := Rectangle {
            y: header.y + header.height;
            height: root.height - self.y;
            clip: true;
            GamesPage {
                enabled: AppApi.tab == 0 && abs(root.page-pos) < 0.01 && !root.any-overlay && !UpdateApi.open && !ChangelogApi.open;
                x: (0 - root.page-pos) * parent.width;
                width: parent.width;
                height: parent.height;
                visible: abs(0 - root.page-pos) < 0.999;
            }
            MusicPage {
                x: (1 - root.page-pos) * parent.width;
                width: parent.width;
                height: parent.height;
                visible: abs(1 - root.page-pos) < 0.999;
            }
            PrintWorksPage {
                x: (2 - root.page-pos) * parent.width;
                width: parent.width;
                height: parent.height;
                visible: abs(2 - root.page-pos) < 0.999;
            }
            TouchArea {
                enabled: abs(root.page-pos - AppApi.tab) > 0.01;
                visible: self.enabled;
            }
        }

        Scrim {
            shown: root.any-overlay;
            strength: 0.42;
            dismiss => { AppApi.scrim-clicked(); }
        }

        popover := GameSettingsPopover {
            shown: GamesApi.settings-open;
            property <length> right-x: GamesApi.anchor-x + GamesApi.anchor-width + 12px;
            property <length> left-x: GamesApi.anchor-x - self.width - 12px;
            property <bool> on-right: right-x + self.width <= root.width - 10px;
            x: round((on-right ? right-x : max(10px, left-x)) / 1px) * 1px;
            origin-x: on-right ? 0px : self.width;
            origin-y: GamesApi.anchor-y + pages.y - self.y + 28px;
            y: round(max(pages.y + 6px, min(root.height - self.height - 10px, GamesApi.anchor-y + pages.y)) / 1px) * 1px;
        }

        SettingsDialog {
            shown: SettingsApi.open;
            x: round((root.width - self.width) / 2px) * 1px;
            y: round((root.height + root.title-bar-height - self.height) / 2px) * 1px;
        }

        DownloadDialog {
            x: round((root.width - self.width) / 2px) * 1px;
            y: round((root.height + root.title-bar-height - self.height) / 2px) * 1px;
        }

        MessageDialog {
            x: round((root.width - self.width) / 2px) * 1px;
            y: round((root.height + root.title-bar-height - self.height) / 2px) * 1px;
        }

        Scrim {
            shown: (UpdateApi.open || ChangelogApi.open) && !root.any-overlay;
            strength: 0.42;
        }

        Rectangle {
            background: black;
            opacity: (UpdateApi.open || ChangelogApi.open) && root.any-overlay ? 0.3 : 0;
            visible: self.opacity > 0.001;
            animate opacity { duration: 220ms; easing: ease-out; }
            TouchArea {
                enabled: UpdateApi.open || ChangelogApi.open;
                scroll-event(e) => { accept }
            }
        }

        UpdateDialog {
            x: round((root.width - self.width) / 2px) * 1px;
            y: round((root.height + root.title-bar-height - self.height) / 2px) * 1px;
        }

        ChangelogDialog {
            x: round((root.width - self.width) / 2px) * 1px;
            y: round((root.height + root.title-bar-height - self.height) / 2px) * 1px;
        }

        if root.no-frame: TitleBar {
            y: 0px;
            height: root.title-bar-height;
            title: root.title;
            expanded: AppApi.window-expanded;
            minimize => { AppApi.minimize-window(); }
            toggle-maximized => { AppApi.toggle-window-maximized(); }
            close => { AppApi.close-window(); }
        }
    }
}
