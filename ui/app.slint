import "fonts/Rubik.ttf";
import { Theme, Ease, Icons } from "theme.slint";
import { Ico, Scrim, MenuItem } from "widgets.slint";
import { GamesPage, GamesApi, GameCardData, GameSettingsPopover } from "games.slint";
import { MusicPage, MusicApi, TrackRow } from "music.slint";
import { PrintWorksPage, PrintApi, PrintWorkData } from "printworks.slint";
import { SettingsDialog, SettingsApi } from "settings.slint";
import { MessageDialog, DownloadDialog, DialogApi, DownloadApi, DialogButton } from "dialogs.slint";
import { ReaderWindow } from "reader.slint";
import { UpdateDialog, UpdateApi, ChangelogDialog, ChangelogApi } from "update.slint";

export { Theme, GamesApi, GameCardData, MusicApi, TrackRow, MenuItem, PrintApi, PrintWorkData, SettingsApi, DialogApi, DownloadApi, DialogButton, ReaderWindow, UpdateApi, ChangelogApi }

export global AppApi {
    in-out property <int> tab: 0;
    in-out property <bool> ready: false;
    callback tab-changed(int);
    callback escape();
    callback scrim-clicked();
}

component TabSwitcher inherits Rectangle {
    property <[string]> labels: ["Games", "Music", "Print Works"];
    property <length> pad: 24px;
    property <length> w0: t0.preferred-width + 2 * pad;
    property <length> w1: t1.preferred-width + 2 * pad;
    property <length> w2: t2.preferred-width + 2 * pad;
    property <length> btn-h: 30px;
    width: x2 + w2 + 6px;
    height: btn-h + 10px;
    border-radius: self.height / 2;
    background: Theme.alpha(Theme.fg, 0.06);
    border-width: 1px;
    border-color: Theme.alpha(Theme.fg, 0.08);
    animate background, border-color { duration: 300ms; }

    property <length> x0: 6px;
    property <length> x1: x0 + w0 + 4px;
    property <length> x2: x1 + w1 + 4px;

    pill := Rectangle {
        y: 5px;
        height: root.btn-h;
        x: AppApi.tab == 0 ? root.x0 : AppApi.tab == 1 ? root.x1 : root.x2;
        width: AppApi.tab == 0 ? root.w0 : AppApi.tab == 1 ? root.w1 : root.w2;
        border-radius: self.height / 2;
        background: Theme.accent;
        animate x, width { duration: 320ms; easing: Ease.soft-spring; }
        animate background { duration: 300ms; }
    }

    for label[i] in labels: Rectangle {
        y: 5px;
        height: root.btn-h;
        x: i == 0 ? root.x0 : i == 1 ? root.x1 : root.x2;
        width: i == 0 ? root.w0 : i == 1 ? root.w1 : root.w2;
        border-radius: self.height / 2;
        property <bool> active: AppApi.tab == i;
        background: !active && ta.pressed ? Theme.alpha(Theme.fg, 0.12) : !active && ta.has-hover ? Theme.alpha(Theme.fg, 0.07) : transparent;
        transform-scale: ta.pressed ? 0.95 : 1;
        animate background { duration: 180ms; }
        animate transform-scale { duration: 140ms; }
        Text {
            text: label;
            font-weight: 700;
            font-size: Theme.base;
            color: active ? (Theme.dark ? Theme.on-accent : #000000) : Theme.fg;
            opacity: active || ta.has-hover ? 1 : 0.72;
            animate color { duration: 200ms; }
            animate opacity { duration: 180ms; }
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if AppApi.tab != i {
                    AppApi.tab = i;
                    AppApi.tab-changed(i);
                }
            }
        }
    }
    t0 := Text { visible: false; text: "Games"; font-weight: 700; font-size: Theme.base; }
    t1 := Text { visible: false; text: "Music"; font-weight: 700; font-size: Theme.base; }
    t2 := Text { visible: false; text: "Print Works"; font-weight: 700; font-size: Theme.base; }
}

component GearButton inherits Rectangle {
    callback clicked();
    width: 40px;
    height: 40px;
    border-radius: ta.pressed ? 15px : 12px;
    background: ta.pressed ? Theme.alpha(Theme.accent, 0.24) : ta.has-hover ? Theme.alpha(Theme.accent, 0.14) : transparent;
    transform-scale: ta.pressed ? 0.92 : 1;
    animate background { duration: 180ms; }
    animate border-radius { duration: 220ms; easing: Ease.standard; }
    animate transform-scale { duration: 180ms; }
    Ico {
        source: Icons.gear;
        size: 21px;
        color: ta.has-hover || ta.pressed ? Theme.accent : Theme.fg-dim;
        transform-rotation: ta.pressed ? 70deg : ta.has-hover ? 35deg : 0deg;
        transform-scale: ta.pressed ? 0.9 : 1;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        animate transform-rotation, transform-scale { duration: 220ms; easing: Ease.standard; }
        animate color { duration: 180ms; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "Mukyu Launcher";
    icon: Icons.app-icon;
    preferred-width: 1280px;
    preferred-height: 720px;
    min-width: 820px;
    min-height: 560px;
    background: Theme.bg;
    default-font-family: "Rubik";
    default-font-size: Theme.base;

    changed width => { Theme.scale = max(0.65, min(1.0, min(self.width / 1280px, self.height / 720px))); }
    changed height => { Theme.scale = max(0.65, min(1.0, min(self.width / 1280px, self.height / 720px))); }
    init => {
        Theme.scale = max(0.65, min(1.0, min(self.width / 1280px, self.height / 720px)));
        keys.focus();
    }

    property <bool> any-overlay: GamesApi.settings-open || SettingsApi.open || DialogApi.open || DownloadApi.open;
    property <float> page-pos: AppApi.tab;
    animate page-pos { duration: 280ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }

    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape { AppApi.escape(); return accept; }
            reject
        }

        Rectangle {
            background: Theme.bg;
            animate background { duration: 300ms; }
        }

        header := Rectangle {
            y: 0;
            height: 58px;
            TabSwitcher {
                x: round((parent.width - self.width) / 2px) * 1px;
                y: 10px;
            }
            GearButton {
                x: parent.width - self.width - 12px;
                y: (parent.height - self.height) / 2 + 2px;
                clicked => { SettingsApi.open = true; SettingsApi.page = 2; }
            }
        }

        pages := Rectangle {
            y: header.height;
            height: root.height - header.height;
            clip: true;
            GamesPage {
                x: (0 - root.page-pos) * parent.width;
                width: parent.width;
                height: parent.height;
                visible: abs(0 - root.page-pos) < 0.999;
            }
            MusicPage {
                x: (1 - root.page-pos) * parent.width;
                width: parent.width;
                height: parent.height;
                visible: abs(1 - root.page-pos) < 0.999;
            }
            PrintWorksPage {
                x: (2 - root.page-pos) * parent.width;
                width: parent.width;
                height: parent.height;
                visible: abs(2 - root.page-pos) < 0.999;
            }
            TouchArea {
                enabled: abs(root.page-pos - AppApi.tab) > 0.01;
                visible: self.enabled;
            }
        }

        Scrim {
            shown: root.any-overlay;
            strength: 0.42;
            dismiss => { AppApi.scrim-clicked(); }
        }

        popover := GameSettingsPopover {
            shown: GamesApi.settings-open;
            property <length> right-x: GamesApi.anchor-x + 210px + 12px;
            property <length> left-x: GamesApi.anchor-x - self.width - 12px;
            x: round((right-x + self.width <= root.width - 10px ? right-x : max(10px, left-x)) / 1px) * 1px;
            y: round(max(header.height + 6px, min(root.height - self.height - 10px, GamesApi.anchor-y + header.height)) / 1px) * 1px;
        }

        SettingsDialog {
            shown: SettingsApi.open;
            x: round((root.width - self.width) / 2px) * 1px;
            y: round((root.height - self.height) / 2px) * 1px;
        }

        DownloadDialog {
            x: round((root.width - self.width) / 2px) * 1px;
            y: round((root.height - self.height) / 2px) * 1px;
        }

        MessageDialog {
            x: round((root.width - self.width) / 2px) * 1px;
            y: round((root.height - self.height) / 2px) * 1px;
        }

        Scrim {
            shown: (UpdateApi.open || ChangelogApi.open) && !root.any-overlay;
            strength: 0.42;
        }

        Rectangle {
            background: black;
            opacity: (UpdateApi.open || ChangelogApi.open) && root.any-overlay ? 0.3 : 0;
            visible: self.opacity > 0.001;
            animate opacity { duration: 220ms; easing: ease-out; }
            TouchArea {
                enabled: UpdateApi.open || ChangelogApi.open;
                scroll-event(e) => { accept }
            }
        }

        UpdateDialog {
            x: round((root.width - self.width) / 2px) * 1px;
            y: round((root.height - self.height) / 2px) * 1px;
        }

        ChangelogDialog {
            x: round((root.width - self.width) / 2px) * 1px;
            y: round((root.height - self.height) / 2px) * 1px;
        }
    }
}
