import { Theme } from "theme.slint";

enum WindowAction { minimize, maximize, restore, close }

component WindowControl inherits Rectangle {
    in property <WindowAction> action;
    callback clicked();

    private property <color> tint: action == WindowAction.close
        ? Theme.mix(Theme.danger, Theme.accent, 0.20)
        : action == WindowAction.minimize
            ? Theme.mix(Theme.fg-dim, Theme.accent, 0.35)
            : Theme.accent;

    private property <bool> show-symbol: pointer.has-hover || pointer.pressed || keyboard.has-focus;
    private property <float> shape-progress: pointer.pressed ? 0.35 : pointer.has-hover ? 1 : 0;
    private property <float> symbol-opacity: show-symbol ? 1 : 0;

    animate shape-progress { duration: pointer.pressed ? 100ms : 185ms; easing: spring(0.1); }
    animate symbol-opacity { duration: show-symbol ? 120ms : 65ms; easing: ease-out; }

    width: 30px;
    height: 26px;
    forward-focus: keyboard;

    accessible-role: button;
    accessible-label: action == WindowAction.minimize ? "Minimize"
        : action == WindowAction.maximize ? "Maximize"
        : action == WindowAction.restore ? "Restore" : "Close";
    accessible-action-default => { root.clicked(); }

    if keyboard.has-focus: Rectangle {
        width: 24px;
        height: 24px;
        border-radius: self.width / 2;
        border-width: 1px;
        border-color: Theme.fg-dim;
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px + 7px * root.shape-progress;
        height: 16px + 5px * root.shape-progress;
        border-radius: 8px - 1.5px * root.shape-progress;
        background: Theme.mix(Theme.surface-alt, root.tint,
            pointer.pressed ? 0.24 : pointer.has-hover ? 0.34 : 0.44);
        animate background { duration: 110ms; easing: ease-out; }

        Path {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 12px;
            height: 12px;
            viewbox-width: 10;
            viewbox-height: 10;
            fill: transparent;
            stroke: Theme.fg;
            stroke-width: 1.25px;
            opacity: root.symbol-opacity;
            commands: root.action == WindowAction.minimize ? "M2 5H8"
                : root.action == WindowAction.maximize ? "M2 5V2H5 M5 8H8V5"
                : root.action == WindowAction.restore ? "M2 5H5V2 M5 8V5H8"
                : "M2.5 2.5L7.5 7.5 M7.5 2.5L2.5 7.5";
        }
    }

    keyboard := FocusScope {
        pointer := TouchArea {
            clicked => { root.clicked(); }
        }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                if !event.repeat { root.clicked(); }
                return accept;
            }
            reject
        }
    }
}

export component TitleBar inherits Rectangle {
    in property <string> title;
    in property <bool> expanded;
    callback minimize();
    callback toggle-maximized();
    callback close();

    WindowMoveArea {
        x: 0px;
        width: controls.x;
        TouchArea {
            double-clicked => { root.toggle-maximized(); }
        }
    }
    Text {
        x: controls.width + 12px;
        width: max(0px, parent.width - 2 * self.x);
        height: parent.height;
        text: root.title;
        color: Theme.fg-dim;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: 250ms; }
    }
    controls := HorizontalLayout {
        x: parent.width - self.width - 12px;
        y: (parent.height - self.height) / 2;
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: 2px;

        WindowControl {
            action: WindowAction.minimize;
            clicked => { root.minimize(); }
        }
        WindowControl {
            action: root.expanded ? WindowAction.restore : WindowAction.maximize;
            clicked => { root.toggle-maximized(); }
        }
        WindowControl {
            action: WindowAction.close;
            clicked => { root.close(); }
        }
    }
}
