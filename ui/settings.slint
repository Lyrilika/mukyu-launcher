import { Theme, Ease, Icons } from "theme.slint";
import { Ico, Btn, Field, ScrollBox, Switch } from "widgets.slint";

export global SettingsApi {
    in-out property <bool> open: false;
    in-out property <int> page: 2;
    in-out property <bool> dark: true;
    in-out property <string> accent: "#d96bc8";
    in-out property <[string]> presets: ["#d96bc8", "#e97fae", "#9b87f5", "#62a0ea", "#5cc8c8", "#78c98a", "#e99a5a", "#d9bc66"];
    in-out property <[color]> preset-colors: [#d96bc8, #e97fae, #9b87f5, #62a0ea, #5cc8c8, #78c98a, #e99a5a, #d9bc66];
    in-out property <[string]> preset-names: ["Pink", "Rose", "Purple", "Blue", "Cyan", "Green", "Orange", "Yellow"];
    in-out property <string> build-title: "Linux build";
    in-out property <string> build-arch: "x86_64";
    in-out property <string> version: "";
    in-out property <float> hue: 0.85;
    in-out property <float> sat: 0.5;
    in-out property <float> val: 0.85;
    in-out property <string> hex-text: "#d96bc8";
    in-out property <bool> picker-open: false;
    in-out property <bool> auto-update: true;
    callback set-auto-update(bool);
    in-out property <bool> show-changelog: true;
    callback set-show-changelog(bool);
    in-out property <int> update-check: 0;
    in-out property <string> update-check-text;
    callback check-updates();

    callback close();
    callback set-dark(bool);
    callback pick-preset(string);
    callback picker-changed(float, float, float, bool);
    callback hex-entered(string);
    callback open-github();
    pure callback hsv-color(float, float, float) -> color;
}

component NavButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active;
    callback clicked();
    height: 34px;
    border-radius: 10px;
    background: active ? Theme.alpha(Theme.accent, 0.2) : ta.pressed ? Theme.alpha(Theme.fg, 0.12) : ta.has-hover ? Theme.alpha(Theme.fg, 0.07) : transparent;
    animate background { duration: 160ms; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Ico {
            y: (parent.height - self.height) / 2;
            source: root.icon;
            size: 16px;
            color: root.active || ta.has-hover ? Theme.fg : Theme.fg-dim;
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Theme.px(13px);
            font-weight: root.active ? 700 : 500;
            color: root.active || ta.has-hover ? Theme.fg : Theme.fg-dim;
            animate color { duration: 160ms; }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Row inherits Rectangle {
    in property <string> title;
    in property <string> desc;
    height: max(40px, txt.preferred-height + 18px);
    txt := VerticalLayout {
        x: 14px;
        width: parent.width - 28px - ctrl.width - 12px;
        alignment: center;
        spacing: 1px;
        Text {
            text: root.title;
            color: Theme.fg;
            font-size: Theme.px(12px);
            font-weight: 700;
        }
        if root.desc != "": Text {
            text: root.desc;
            color: Theme.fg-dim;
            font-size: Theme.px(10px);
            wrap: word-wrap;
        }
    }
    ctrl := HorizontalLayout {
        x: parent.width - self.width - 14px;
        y: (parent.height - self.height) / 2;
        width: self.preferred-width;
        height: self.preferred-height;
        @children
    }
}

component CheckUpdatesButton inherits Rectangle {
    property <bool> busy: SettingsApi.update-check == 1;
    property <bool> hovered: ta.has-hover && !busy;
    height: 36px;
    width: lay.preferred-width;
    border-radius: 10px;
    background: ta.pressed && !busy ? Theme.alpha(Theme.accent, 0.32) : hovered ? Theme.alpha(Theme.accent, 0.24) : Theme.alpha(Theme.accent, 0.14);
    border-width: 1px;
    border-color: hovered ? Theme.alpha(Theme.accent, 0.45) : Theme.alpha(Theme.accent, 0.22);
    transform-scale: ta.pressed && !busy ? 0.96 : 1;
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    animate background, border-color { duration: 180ms; }
    animate transform-scale { duration: 240ms; easing: Ease.spring; }
    lay := HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        spacing: 8px;
        Ico {
            y: (parent.height - self.height) / 2;
            source: Icons.refresh;
            size: 16px;
            color: Theme.accent;
            property <angle> spin: root.busy ? mod(animation-tick() / 800ms, 1.0) * 360deg : 0deg;
            property <angle> nudge: root.hovered ? 60deg : 0deg;
            animate nudge { duration: 420ms; easing: Ease.spring; }
            transform-rotation: self.spin + self.nudge;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
        }
        Text {
            min-width: probe.preferred-width;
            text: root.busy ? "Checking…" : "Check for updates";
            font-size: Theme.px(12px);
            font-weight: 700;
            color: Theme.fg;
            vertical-alignment: center;
        }
    }
    probe := Text {
        visible: false;
        text: "Check for updates";
        font-size: Theme.px(12px);
        font-weight: 700;
    }
    ta := TouchArea {
        enabled: !root.busy;
        mouse-cursor: root.busy ? default : pointer;
        clicked => { SettingsApi.check-updates(); }
    }
}

component UpdateCheckStatus inherits Rectangle {
    property <int> st: SettingsApi.update-check;
    property <bool> shown: st >= 2;
    property <bool> bad: st == 3;
    height: 22px;
    opacity: shown ? 1 : 0;
    animate opacity { duration: 220ms; easing: ease-out; }
    HorizontalLayout {
        x: 4px;
        y: root.shown ? 0px : -6px;
        animate y { duration: 380ms; easing: Ease.emphasized; }
        spacing: 6px;
        alignment: start;
        Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            background: root.bad ? Theme.alpha(Theme.danger, 0.18) : Theme.accent;
            Ico {
                source: root.bad ? Icons.close : Icons.check;
                size: 12px;
                color: root.bad ? Theme.danger-text : Theme.on-accent;
                transform-scale: root.shown ? 1 : 0.3;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                animate transform-scale { duration: 460ms; delay: 80ms; easing: Ease.spring; }
            }
        }
        Text {
            text: SettingsApi.update-check-text;
            font-size: Theme.px(11px);
            font-weight: 600;
            color: root.bad ? Theme.danger-text : Theme.fg-dim;
            vertical-alignment: center;
        }
    }
}

component Section inherits VerticalLayout {
    in property <string> title;
    in property <string> note;
    spacing: 6px;
    Text {
        text: root.title;
        x: 4px;
        color: Theme.fg-dim;
        font-size: Theme.px(11px);
        font-weight: 800;
    }
    Rectangle {
        border-radius: 14px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.alpha(Theme.fg, 0.07);
        clip: true;
        height: rows.preferred-height;
        animate background { duration: 300ms; }
        rows := VerticalLayout {
            @children
        }
    }
    if root.note != "": Text {
        text: root.note;
        color: Theme.fg-dim;
        opacity: 0.85;
        font-size: Theme.px(10px);
        wrap: word-wrap;
    }
}

component Sep inherits Rectangle {
    height: 1px;
    background: Theme.alpha(Theme.fg, 0.07);
}

component ModeSelector inherits Rectangle {
    width: 2 * 72px + 8px;
    height: 28px + 8px;
    border-radius: 11px;
    background: Theme.alpha(Theme.fg, 0.06);
    border-width: 1px;
    border-color: Theme.alpha(Theme.fg, 0.07);
    pill := Rectangle {
        x: 4px + (SettingsApi.dark ? 0px : 72px);
        y: 4px;
        width: 72px;
        height: 28px;
        border-radius: 8px;
        background: Theme.mix(Theme.surface-high, Theme.accent, 0.35);
        border-width: 1px;
        border-color: Theme.alpha(Theme.accent, 0.35);
        animate x { duration: 200ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    }
    for label[i] in ["Dark", "Light"]: Rectangle {
        x: 4px + i * 72px;
        y: 4px;
        width: 72px;
        height: 28px;
        property <bool> active: (i == 0) == SettingsApi.dark;
        Text {
            text: label;
            font-size: Theme.px(13px);
            font-weight: active ? 800 : 700;
            color: active || mta.has-hover ? Theme.fg : Theme.fg-dim;
            animate color { duration: 160ms; }
        }
        mta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if !active { SettingsApi.set-dark(i == 0); }
            }
        }
    }
}

component Swatch inherits Rectangle {
    in property <string> hex;
    in property <color> fill;
    in property <bool> selected;
    callback clicked();
    width: 30px;
    height: 30px;
    border-radius: 15px;
    border-width: 2px;
    border-color: selected ? Theme.fg : ta.has-hover ? Theme.alpha(Theme.fg, 0.28) : transparent;
    animate border-color { duration: 140ms; }
    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: root.fill;
        transform-scale: ta.pressed ? 0.85 : ta.has-hover ? 1.08 : 1;
        animate transform-scale { duration: 200ms; easing: Ease.spring; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ColorPicker inherits Rectangle {
    width: 260px;
    height: col.preferred-height + 24px;
    property <bool> dragging-sv;
    property <bool> dragging-hue;
    col := VerticalLayout {
        x: 12px;
        y: 12px;
        width: 236px;
        spacing: 12px;
        sv := Rectangle {
            height: 160px;
            border-radius: 10px;
            clip: true;
            background: SettingsApi.hsv-color(SettingsApi.hue, 1, 1);
            Rectangle { background: @linear-gradient(90deg, #ffffffff 0%, #ffffff00 100%); }
            Rectangle { background: @linear-gradient(180deg, #00000000 0%, #000000ff 100%); }
            Rectangle {
                x: max(8px, min(parent.width - 8px, SettingsApi.sat * parent.width)) - 9.5px;
                y: max(8px, min(parent.height - 8px, (1 - SettingsApi.val) * parent.height)) - 9.5px;
                width: 19px;
                height: 19px;
                border-radius: 9.5px;
                border-width: 1px;
                border-color: #00000059;
                Rectangle {
                    x: 1.5px;
                    y: 1.5px;
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    border-width: 3px;
                    border-color: white;
                    background: SettingsApi.hsv-color(SettingsApi.hue, SettingsApi.sat, SettingsApi.val);
                }
            }
            TouchArea {
                mouse-cursor: crosshair;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        SettingsApi.sat = max(0, min(1, self.mouse-x / self.width));
                        SettingsApi.val = max(0, min(1, 1 - self.mouse-y / self.height));
                        SettingsApi.picker-changed(SettingsApi.hue, SettingsApi.sat, SettingsApi.val, false);
                    } else if e.kind == PointerEventKind.up {
                        SettingsApi.picker-changed(SettingsApi.hue, SettingsApi.sat, SettingsApi.val, true);
                    }
                }
                moved => {
                    SettingsApi.sat = max(0, min(1, self.mouse-x / self.width));
                    SettingsApi.val = max(0, min(1, 1 - self.mouse-y / self.height));
                    SettingsApi.picker-changed(SettingsApi.hue, SettingsApi.sat, SettingsApi.val, false);
                }
            }
        }
        hue := Rectangle {
            height: 22px;
            Rectangle {
                y: 3px;
                height: 16px;
                border-radius: 8px;
                background: @linear-gradient(90deg, #ff0000 0%, #ffff00 16.67%, #00ff00 33.33%, #00ffff 50%, #0000ff 66.67%, #ff00ff 83.33%, #ff0000 100%);
            }
            Rectangle {
                property <length> r: 10px;
                x: max(r, min(parent.width - r, SettingsApi.hue * parent.width)) - r - 1.5px;
                y: 11px - r - 1.5px;
                width: 2 * r + 3px;
                height: 2 * r + 3px;
                border-radius: r + 1.5px;
                border-width: 1px;
                border-color: #00000059;
                Rectangle {
                    x: 1.5px;
                    y: 1.5px;
                    width: 2 * parent.r;
                    height: 2 * parent.r;
                    border-radius: parent.r;
                    border-width: 3px;
                    border-color: white;
                    background: SettingsApi.hsv-color(SettingsApi.hue, 1, 1);
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        SettingsApi.hue = max(0, min(1, self.mouse-x / self.width));
                        SettingsApi.picker-changed(SettingsApi.hue, SettingsApi.sat, SettingsApi.val, false);
                    } else if e.kind == PointerEventKind.up {
                        SettingsApi.picker-changed(SettingsApi.hue, SettingsApi.sat, SettingsApi.val, true);
                    }
                }
                moved => {
                    SettingsApi.hue = max(0, min(1, self.mouse-x / self.width));
                    SettingsApi.picker-changed(SettingsApi.hue, SettingsApi.sat, SettingsApi.val, false);
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 34px;
                height: 30px;
                y: 1px;
                border-radius: 8px;
                border-width: 1px;
                border-color: #8080807a;
                background: SettingsApi.hsv-color(SettingsApi.hue, SettingsApi.sat, SettingsApi.val);
            }
            Field {
                h: 32px;
                radius: 8px;
                mono: true;
                text: SettingsApi.hex-text;
                placeholder: "#rrggbb";
                bg: Theme.alpha(Theme.fg, 0.08);
                bg-focus: Theme.alpha(Theme.accent, 0.12);
                edited(t) => { SettingsApi.hex-text = t; SettingsApi.hex-entered(t); }
                accepted(t) => { SettingsApi.hex-entered(t); }
            }
        }
    }
}

export component SettingsDialog inherits Rectangle {
    in property <bool> shown;
    width: 700px;
    height: 470px;
    border-radius: 18px;
    background: Theme.bg;
    border-width: 1px;
    border-color: Theme.alpha(Theme.fg, 0.08);
    drop-shadow-blur: 48px;
    drop-shadow-offset-y: 20px;
    drop-shadow-color: #00000080;
    clip: true;
    opacity: shown ? 1 : 0;
    transform-scale: shown ? 1 : 0.94;
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    animate opacity { duration: shown ? 160ms : 120ms; easing: shown ? ease-out : cubic-bezier(0.3, 0, 0.8, 0.15); }
    animate transform-scale { duration: shown ? 420ms : 140ms; easing: shown ? spring(0.22) : cubic-bezier(0.3, 0, 0.8, 0.15); }
    animate background { duration: 300ms; }
    visible: self.opacity > 0.01;

    TouchArea { }
    sidebar := Rectangle {
        x: 0;
        width: 168px;
        background: Theme.surface;
        animate background { duration: 300ms; }
        Rectangle {
            x: parent.width - 1px;
            width: 1px;
            background: Theme.alpha(Theme.fg, 0.07);
        }
        VerticalLayout {
            padding: 12px;
            padding-left: 8px;
            padding-right: 8px;
            spacing: 2px;
            alignment: start;
            Text {
                text: "Settings";
                font-size: Theme.px(15px);
                font-weight: 800;
                color: Theme.fg;
                x: 8px;
                height: self.preferred-height + 10px;
            }
            NavButton {
                text: "General";
                icon: Icons.gear;
                active: SettingsApi.page == 2;
                clicked => { SettingsApi.page = 2; }
            }
            NavButton {
                text: "Theme";
                icon: Icons.contrast;
                active: SettingsApi.page == 0;
                clicked => { SettingsApi.page = 0; }
            }
            NavButton {
                text: "About";
                icon: Icons.info;
                active: SettingsApi.page == 1;
                clicked => { SettingsApi.page = 1; }
            }
        }
    }
    close-btn := Rectangle {
        x: parent.width - 40px;
        y: 10px;
        width: 30px;
        height: 30px;
        border-radius: 15px;
        background: cta.has-hover ? Theme.alpha(Theme.fg, 0.1) : transparent;
        animate background { duration: 150ms; }
        Ico {
            source: Icons.close;
            size: 16px;
            color: Theme.fg-dim;
        }
        cta := TouchArea {
            mouse-cursor: pointer;
            clicked => { SettingsApi.close(); }
        }
    }

    content := Rectangle {
        x: sidebar.width;
        width: parent.width - sidebar.width;
        general-page := Rectangle {
            opacity: SettingsApi.page == 2 ? 1 : 0;
            visible: self.opacity > 0.01;
            animate opacity { duration: 160ms; }
            VerticalLayout {
                padding: 22px;
                padding-top: 16px;
                spacing: 16px;
                alignment: start;
                Text {
                    text: "General";
                    font-size: Theme.px(21px);
                    font-weight: 800;
                    color: Theme.fg;
                }
                Section {
                    title: "Updates";
                    Row {
                        title: "Check for updates automatically";
                        desc: "Look for a new version each time Mukyu Launcher starts";
                        Switch {
                            checked: SettingsApi.auto-update;
                            toggled(on) => { SettingsApi.set-auto-update(on); }
                        }
                    }
                    Sep { }
                    Row {
                        title: "Show what's new after updating";
                        desc: "Open the release notes the first time a new version starts";
                        Switch {
                            checked: SettingsApi.show-changelog;
                            toggled(on) => { SettingsApi.set-show-changelog(on); }
                        }
                    }
                }
                VerticalLayout {
                    spacing: 8px;
                    padding-left: 2px;
                    HorizontalLayout {
                        alignment: start;
                        CheckUpdatesButton { }
                    }
                    UpdateCheckStatus { }
                }
            }
        }
        theme-page := Rectangle {
            opacity: SettingsApi.page == 0 ? 1 : 0;
            visible: self.opacity > 0.01;
            animate opacity { duration: 160ms; }
            VerticalLayout {
                padding: 22px;
                padding-top: 16px;
                spacing: 16px;
                alignment: start;
                Text {
                    text: "Theme";
                    font-size: Theme.px(21px);
                    font-weight: 800;
                    color: Theme.fg;
                }
                Section {
                    title: "Appearance";
                    Row {
                        title: "Mode";
                        desc: "Dark or light launcher palette";
                        ModeSelector { }
                    }
                }
                accent-section := Section {
                    title: "Accent color";
                    note: "The Music tab keeps its own album-art palette.";
                    Row {
                        title: "Presets";
                        HorizontalLayout {
                            spacing: 6px;
                            for p[i] in SettingsApi.presets: Swatch {
                                hex: p;
                                fill: SettingsApi.preset-colors[i];
                                selected: SettingsApi.accent == p;
                                clicked => { SettingsApi.pick-preset(p); }
                            }
                        }
                    }
                    Sep { }
                    Row {
                        title: "Custom color";
                        desc: "Pick any color with the picker";
                        picker-btn := Rectangle {
                            width: 48px;
                            height: 30px;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: pta.has-hover ? Theme.alpha(Theme.accent, 0.45) : Theme.alpha(Theme.fg, 0.12);
                            background: Theme.alpha(Theme.fg, 0.06);
                            animate border-color { duration: 150ms; }
                            Rectangle {
                                width: 30px;
                                height: 16px;
                                border-radius: 5px;
                                background: Theme.accent;
                            }
                            pta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { SettingsApi.picker-open = !SettingsApi.picker-open; }
                            }
                        }
                    }
                }
            }
            picker := Rectangle {
                property <bool> shown: SettingsApi.picker-open && SettingsApi.page == 0;
                x: parent.width - self.width - 84px;
                y: parent.height - self.height - 16px + (shown ? 0px : 8px);
                width: cp.width;
                height: cp.height;
                border-radius: 14px;
                background: Theme.popover;
                border-width: 1px;
                border-color: Theme.alpha(Theme.fg, 0.10);
                drop-shadow-blur: 28px;
                drop-shadow-offset-y: 10px;
                drop-shadow-color: #00000066;
                opacity: shown ? 1 : 0;
                visible: self.opacity > 0.01;
                animate opacity, y { duration: 220ms; easing: Ease.emphasized; }
                TouchArea { }
                cp := ColorPicker { }
            }
        }
        about-page := Rectangle {
            opacity: SettingsApi.page == 1 ? 1 : 0;
            visible: self.opacity > 0.01;
            animate opacity { duration: 160ms; }
            VerticalLayout {
                padding: 22px;
                padding-top: 16px;
                spacing: 16px;
                alignment: start;
                Text {
                    text: "About";
                    font-size: Theme.px(21px);
                    font-weight: 800;
                    color: Theme.fg;
                }
                VerticalLayout {
                    spacing: 10px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    alignment: start;
                    HorizontalLayout {
                        alignment: center;
                        Image {
                            source: Icons.app-icon;
                            width: 112px;
                            height: 112px;
                        }
                    }
                    Text {
                        text: "Mukyu Launcher";
                        horizontal-alignment: center;
                        font-size: Theme.px(21px);
                        font-weight: 800;
                        color: Theme.fg;
                    }
                    if SettingsApi.version != "": Text {
                        text: "Version " + SettingsApi.version;
                        horizontal-alignment: center;
                        font-size: Theme.px(11px);
                        color: Theme.fg-dim;
                    }
                    HorizontalLayout {
                        alignment: center;
                        Btn {
                            h: 44px;
                            pad: 24px;
                            radius: 22px;
                            text: "GitHub";
                            has-icon: true;
                            icon: Icons.github;
                            icon-size: 22px;
                            weight: 700;
                            bg: Theme.accent;
                            bg-hover: Theme.mix(Theme.accent, Theme.on-accent, 0.08);
                            bg-pressed: Theme.mix(Theme.accent, Theme.on-accent, 0.16);
                            fg: Theme.on-accent;
                            clicked => { SettingsApi.open-github(); }
                        }
                    }
                }
                Section {
                    title: "Build";
                    Row {
                        title: SettingsApi.build-title;
                        desc: SettingsApi.build-arch;
                    }
                }
            }
        }
    }
}
