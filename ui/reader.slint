import { Theme, Ease, Icons } from "theme.slint";
import { Ico, Spinner } from "widgets.slint";

component NavCircle inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> hidden: false;
    callback clicked();
    width: 52px;
    height: 52px;
    border-radius: 26px;
    background: ta.has-hover && enabled ? #ffffff38 : #00000080;
    border-width: 1px;
    border-color: ta.has-hover && enabled ? #ffffff73 : #ffffff33;
    opacity: hidden ? 0 : enabled ? 1 : 0.2;
    transform-scale: ta.pressed && enabled ? 0.92 : ta.has-hover && enabled ? 1.08 : 1;
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    animate opacity { duration: 250ms; }
    animate background, border-color { duration: 150ms; }
    animate transform-scale { duration: 180ms; easing: Ease.standard; }
    Ico {
        source: root.icon;
        size: 28px;
        color: white;
    }
    ta := TouchArea {
        enabled: root.enabled && !root.hidden;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ReaderWindow inherits Window {
    title: doc-title != "" ? doc-title : "Reader";
    background: black;
    preferred-width: 1280px;
    preferred-height: 720px;
    default-font-family: "Rubik";
    icon: Icons.app-icon;

    in property <string> doc-title;
    in property <image> page;
    in property <bool> has-page: false;
    in property <int> count: 0;
    in property <int> current: 0;
    in property <bool> ui-visible: true;
    in property <string> toast-text;
    in property <bool> toast-on: false;
    in property <bool> spinner-on: true;
    in property <string> error-text;
    out property <length> area-width: area.width;
    out property <length> area-height: area.height;

    callback next();
    callback prev();
    callback go(int);
    callback close-reader();
    callback toggle-fullscreen();
    callback poke();
    callback scrolled(length);
    callback picture-clicked(length, length);

    property <string> pages-text: count > 0 ? (current + 1) + " / " + count : "";

    fs := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape || e.text == "q" || e.text == "Q" { root.close-reader(); return accept; }
            if e.text == " " && e.modifiers.shift { root.prev(); return accept; }
            if e.text == Key.RightArrow || e.text == Key.DownArrow || e.text == Key.PageDown || e.text == " " || e.text == Key.Return {
                root.next(); return accept;
            }
            if e.text == Key.LeftArrow || e.text == Key.UpArrow || e.text == Key.PageUp || e.text == Key.Backspace {
                root.prev(); return accept;
            }
            if e.text == Key.Home { root.go(0); return accept; }
            if e.text == Key.End { root.go(root.count - 1); return accept; }
            if e.text == "f" || e.text == "F" || e.text == Key.F11 { root.toggle-fullscreen(); return accept; }
            reject
        }

        area := Rectangle {
            Image {
                width: parent.width;
                height: parent.height;
                source: root.page;
                image-fit: ImageFit.contain;
                visible: root.has-page;
            }
            SwipeGestureHandler {
                enabled: root.count > 1;
                handle-swipe-up: true;
                handle-swipe-down: true;
                moved => { root.poke(); }
                swiped => {
                    let distance = self.current-position.y - self.pressed-position.y;
                    if distance <= -40px { root.next(); }
                    else if distance >= 40px { root.prev(); }
                }

                TouchArea {
                    mouse-cursor: root.ui-visible ? default : none;
                    moved => { root.poke(); }
                    changed mouse-x => { root.poke(); }
                    changed mouse-y => { root.poke(); }
                    clicked => { root.picture-clicked(self.mouse-x, self.width); }
                    scroll-event(e) => {
                        root.scrolled(e.delta-y);
                        accept
                    }
                }
            }
        }

        if root.spinner-on && root.error-text == "": Spinner {
            size: 48px;
            fg: white;
        }
        if root.error-text != "": Text {
            width: min(root.width - 80px, 520px);
            text: root.error-text + "\n\nPress Esc to go back.";
            color: white;
            font-weight: 700;
            font-size: Theme.px(14px);
            wrap: word-wrap;
            horizontal-alignment: center;
        }

        NavCircle {
            x: 20px;
            y: (root.height - self.height) / 2;
            icon: Icons.chevron-left;
            hidden: !root.ui-visible;
            enabled: root.count > 1 && root.current > 0;
            clicked => { root.prev(); }
        }
        NavCircle {
            x: root.width - self.width - 20px;
            y: (root.height - self.height) / 2;
            icon: Icons.chevron-right;
            hidden: !root.ui-visible;
            enabled: root.count > 1 && root.current < root.count - 1;
            clicked => { root.next(); }
        }

        top := Rectangle {
            y: 0;
            height: 84px;
            opacity: root.ui-visible ? 1 : 0;
            animate opacity { duration: 250ms; }
            background: @linear-gradient(180deg, #000000c7 0%, #00000000 100%);
            TouchArea { enabled: root.ui-visible; moved => { root.poke(); } }
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 14px;
                padding-bottom: 34px;
                spacing: 12px;
                Text {
                    text: root.doc-title;
                    color: white;
                    font-weight: 700;
                    font-size: Theme.px(14px);
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                close := Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: cta.has-hover ? #ff5555bf : #ffffff1f;
                    transform-scale: cta.pressed ? 0.88 : 1;
                    animate background { duration: 150ms; }
                    animate transform-scale { duration: 160ms; }
                    Ico { source: Icons.close; size: 18px; color: white; }
                    cta := TouchArea {
                        enabled: root.ui-visible;
                        mouse-cursor: pointer;
                        clicked => { root.close-reader(); }
                    }
                }
            }
        }

        bottom := Rectangle {
            y: root.height - self.height;
            height: 112px;
            opacity: root.ui-visible ? 1 : 0;
            animate opacity { duration: 250ms; }
            background: @linear-gradient(0deg, #000000d9 0%, #00000000 100%);
            TouchArea { enabled: root.ui-visible; moved => { root.poke(); } }
            VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 40px;
                padding-bottom: 14px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 16px;
                    slider := Rectangle {
                        horizontal-stretch: 1;
                        height: 20px;
                        property <float> frac: root.count > 1 ? root.current / (root.count - 1) : 0;
                        property <bool> dragging: false;
                        property <length> ripple-x;
                        property <float> ripple-t: 1;
                        property <bool> ripple-instant: false;
                        animate ripple-t { duration: ripple-instant ? 0ms : 520ms; easing: cubic-bezier(0.2, 0.7, 0.2, 1); }
                        property <bool> hot: sta.has-hover && sta.enabled;
                        property <bool> down: sta.pressed && sta.enabled;
                        property <float> hover-frac: max(0, min(1, sta.mouse-x / max(1px, self.width)));
                        property <length> bar-h: down ? 6px : hot ? 8px : 5px;
                        animate bar-h { duration: 220ms; easing: Ease.soft-spring; }
                        Rectangle {
                            x: 0;
                            y: (parent.height - self.height) / 2;
                            height: parent.bar-h;
                            border-radius: self.height / 2;
                            background: parent.hot ? #ffffff59 : #ffffff40;
                            animate background { duration: 220ms; }
                        }
                        Rectangle {
                            x: (parent.width - 16px) * parent.frac + 8px;
                            y: (parent.height - self.height) / 2;
                            width: parent.hot && parent.hover-frac > parent.frac ? (parent.width - 16px) * (parent.hover-frac - parent.frac) : 0px;
                            height: parent.bar-h;
                            border-radius: self.height / 2;
                            background: Theme.alpha(Theme.accent, 0.38);
                            animate width { duration: 140ms; easing: ease-out; }
                        }
                        Rectangle {
                            x: 0;
                            y: (parent.height - self.height) / 2;
                            width: (parent.width - 16px) * parent.frac + 8px;
                            height: parent.bar-h;
                            border-radius: self.height / 2;
                            background: parent.down ? Theme.mix(Theme.accent, white, 0.3) : Theme.accent;
                            animate width { duration: parent.dragging ? 0ms : 160ms; }
                            animate background { duration: 160ms; }
                        }
                        Rectangle {
                            property <length> size: 12px + 30px * slider.ripple-t;
                            x: slider.ripple-x - self.width / 2;
                            y: (slider.height - self.height) / 2;
                            width: size;
                            height: size;
                            border-radius: self.width / 2;
                            border-width: 2px;
                            border-color: Theme.accent;
                            opacity: 0.7 * (1 - slider.ripple-t);
                        }
                        ripple-kick := Timer {
                            interval: 16ms;
                            running: false;
                            triggered => {
                                self.running = false;
                                slider.ripple-instant = false;
                                slider.ripple-t = 1;
                            }
                        }
                        Rectangle {
                            x: (parent.width - 16px) * parent.frac;
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                            border-radius: 8px;
                            background: white;
                            border-width: parent.down ? 3px : 0px;
                            border-color: Theme.accent;
                            transform-scale: parent.down ? 0.85 : parent.hot ? 1.25 : 1;
                            transform-origin: { x: self.width / 2, y: self.height / 2 };
                            drop-shadow-blur: 6px;
                            drop-shadow-offset-y: 1px;
                            drop-shadow-color: #00000099;
                            animate x { duration: parent.dragging ? 0ms : 160ms; }
                            animate transform-scale { duration: 260ms; easing: Ease.spring; }
                            animate border-width { duration: 160ms; }
                        }
                        sta := TouchArea {
                            enabled: root.ui-visible && root.count > 1;
                            mouse-cursor: pointer;
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.down {
                                    slider.ripple-x = self.mouse-x;
                                    slider.ripple-instant = true;
                                    slider.ripple-t = 0;
                                    ripple-kick.running = true;
                                    slider.dragging = true;
                                    root.go(round(max(0, min(1, self.mouse-x / self.width)) * (root.count - 1)));
                                } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                                    slider.dragging = false;
                                }
                            }
                            moved => {
                                root.poke();
                                if slider.dragging {
                                    root.go(round(max(0, min(1, self.mouse-x / self.width)) * (root.count - 1)));
                                }
                            }
                        }
                    }
                    Text {
                        min-width: 90px;
                        text: root.pages-text;
                        color: white;
                        font-weight: 700;
                        font-size: Theme.px(13px);
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: "←  →  turn page      Home / End  first / last      F  windowed      Esc  close";
                    color: #ffffff8c;
                    font-size: Theme.px(12px);
                }
            }
        }

        counter := Rectangle {
            x: root.width - self.width - 16px;
            y: root.height - self.height - 12px;
            width: ct.preferred-width + 24px;
            height: ct.preferred-height + 6px;
            border-radius: self.height / 2;
            background: #00000066;
            opacity: root.ui-visible || root.count == 0 ? 0 : 1;
            animate opacity { duration: 300ms; }
            ct := Text {
                text: root.pages-text;
                color: #ffffffb3;
                font-size: Theme.px(12px);
            }
        }

        toast := Rectangle {
            x: (root.width - self.width) / 2;
            y: root.height - 130px - self.height;
            width: tt.preferred-width + 40px;
            height: tt.preferred-height + 18px;
            border-radius: self.height / 2;
            background: #191919e6;
            border-width: 1px;
            border-color: #ffffff1f;
            opacity: root.toast-on ? 1 : 0;
            animate opacity { duration: 250ms; }
            tt := Text {
                text: root.toast-text;
                color: white;
                font-size: Theme.px(13px);
            }
        }
    }

    init => { fs.focus(); }
}
